{
  "name": "@d4cluvtrain/dsh-plugin-manager",
  "version": "0.1.1",
  "description": "MVP dsh bundle plugin: proves it loaded by registering a /plugin-manager web route, logging, writing a marker file, and adding a sidebar '插件' button whose modal lists the user-installed plugins",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/plugin.mjs",
  "exports": {
    ".": "./lib/plugin.mjs",
    "./client": "./lib/client.js",
    "./installed-plugins": "./lib/installed-plugins.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs",
    "verify:client": "node scripts/verify-client.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/D4Cluv-Train/dsh-plugin-manager.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "esbuild": "^0.25.12",
    "js-yaml": "^4.1.0"
  }
}
